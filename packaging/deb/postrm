#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
# "purge" also removes what Xibalba kept: signing key, caches, statistics,
# the password of the web interface and the changes made there.
if [ "$1" = "purge" ]; then
    rm -rf /var/lib/xibalba
fi
exit 0
